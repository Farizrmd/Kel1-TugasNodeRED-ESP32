    {
        "id": "fn_route_sensor",
        "type": "function",
        "z": "tab_iot4",
        "name": "Pisah data berdasarkan ruangan",
        "func": "// Topic format: gedung/ruangN/temperature|humidity|status\nconst parts = (msg.topic || \"\").split(\"/\");\nif (parts.length !== 3 || parts[0] !== \"gedung\") return null;\n\nconst roomMatch = parts[1].match(/^ruang([1-4])$/);\nif (!roomMatch) return null;\n\nconst room = Number(roomMatch[1]);\nconst kind = parts[2];\nconst indexByKind = { temperature: 0, humidity: 1, status: 2 };\nif (!(kind in indexByKind)) return null;\n\nlet value = msg.payload;\n\n// Terima payload angka langsung atau JSON.\n// Jika JSON berisi field sesuai jenis data, ambil field tersebut.\nif (typeof value === \"string\") {\n    const trimmed = value.trim();\n    try {\n        const parsed = JSON.parse(trimmed);\n        if (parsed && typeof parsed === \"object\") {\n            value = parsed[kind] ?? parsed.value ?? parsed.status ?? value;\n        } else {\n            value = parsed;\n        }\n    } catch (e) {\n        value = trimmed;\n    }\n} else if (value && typeof value === \"object\") {\n    value = value[kind] ?? value.value ?? value.status ?? value;\n}\n\nif (kind === \"temperature\" || kind === \"humidity\") {\n    value = Number(value);\n    if (!Number.isFinite(value)) return null;\n} else {\n    value = String(value);\n}\n\nmsg.payload = value;\nmsg.room = room;\nmsg.kind = kind;\nconst outputIndex = (room - 1) * 3 + indexByKind[kind];\nconst result = Array(outputs).fill(null);\nresult[outputIndex] = msg;\nreturn result;",
        "outputs": 12,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 470,
        "y": 220,
        "wires": [
