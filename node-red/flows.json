  {
    "id": "7fcaed49199b3a54",
    "type": "function",
    "z": "30b9a5dbde642976",
    "name": "Validasi humidity",
    "x": 480,
    "y": 260,
    "func": "if (!/^pens\\/klp1\\/ruang[1-4]\\/humidity$/.test(msg.topic || \"\")) return null;\nif (![\"string\", \"number\"].includes(typeof msg.payload) || String(msg.payload).trim() === \"\") return null;\nconst value = Number(msg.payload);\nif (!Number.isFinite(value) || value < 0 || value > 100) return null;\nmsg.payload = value;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "69a171207de46c9f"
      ]
    ]
  },
