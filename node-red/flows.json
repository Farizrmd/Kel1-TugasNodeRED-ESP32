  {
    "id": "697fd740d5435e09",
    "type": "function",
    "z": "30b9a5dbde642976",
    "name": "Nama ruang untuk seri suhu",
    "x": 480,
    "y": 100,
    "func": "const match = /^pens\\/klp1\\/(ruang[1-4])\\/temperature$/.exec(msg.topic || \"\");\nif (!match || ![\"string\", \"number\"].includes(typeof msg.payload)) return null;\nif (String(msg.payload).trim() === \"\") return null;\nconst value = Number(msg.payload);\nif (!Number.isFinite(value)) return null;\nmsg.topic = match[1];\nmsg.payload = value;\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "wires": [
      [
        "313c217355264415"
      ]
    ]
  },
